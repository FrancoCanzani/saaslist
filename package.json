{
  "name": "saaslist",
  "version": "0.2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "check-types": "bun run cf-typegen && tsc --noEmit && tsc --noEmit -p tsconfig.backend.json && tsc --noEmit -p tsconfig.node.json",
    "typecheck": "bun run check-types",
    "cf-typegen": "wrangler types --strict-vars=false",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "db:generate": "drizzle-kit generate",
    "db:migrate:dev": "wrangler d1 migrations apply app --local",
    "db:migrate": "wrangler d1 migrations apply app --remote",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.5",
    "@fontsource-variable/inter": "^5.2.8",
    "@hono/zod-validator": "^0.9.1",
    "@tanstack/react-query": "^5.90.5",
    "@tanstack/react-router": "^1.170.36",
    "better-auth": "^1.7.5",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.13.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@eslint/js": "^10",
    "@tailwindcss/vite": "^4",
    "@tanstack/router-cli": "^1.132.0",
    "@tanstack/router-plugin": "^1.168.38",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "drizzle-kit": "^0.31.4",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17",
    "tailwindcss": "^4",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "wrangler": "^4.131.2"
  },
  "packageManager": "bun@1.3.3"
}
